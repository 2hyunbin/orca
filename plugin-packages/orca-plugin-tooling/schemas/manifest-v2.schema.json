{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifestVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "url": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "repository": {
      "type": "string",
      "maxLength": 2048
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "engines": {
      "type": "object",
      "properties": {
        "orca": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^>=\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "orca"
      ],
      "additionalProperties": false
    },
    "pluginApi": {
      "type": "number",
      "const": 1
    },
    "main": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "contributes": {
      "type": "object",
      "properties": {
        "panels": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "icon": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "id",
              "title",
              "entry"
            ],
            "additionalProperties": false
          }
        },
        "commands": {
          "default": [],
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "context": {
                "type": "string",
                "enum": [
                  "global",
                  "worktree"
                ]
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "events": {
          "default": [],
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "on": {
                "type": "string",
                "enum": [
                  "worktree.created",
                  "worktree.removed",
                  "agent.status.changed"
                ]
              }
            },
            "required": [
              "on"
            ],
            "additionalProperties": false
          }
        },
        "themes": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "id",
              "label",
              "path"
            ],
            "additionalProperties": false
          }
        },
        "iconThemes": {
          "default": [],
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "id",
              "path"
            ],
            "additionalProperties": false
          }
        },
        "terminalThemes": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "id",
              "label",
              "path"
            ],
            "additionalProperties": false
          }
        },
        "languagePacks": {
          "default": [],
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "locale": {
                "type": "string",
                "minLength": 2,
                "maxLength": 35,
                "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "locale",
              "path"
            ],
            "additionalProperties": false
          }
        },
        "keybindings": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "when": {
                "type": "string",
                "enum": [
                  "global",
                  "worktree"
                ]
              }
            },
            "required": [
              "command",
              "key"
            ],
            "additionalProperties": false
          }
        },
        "vmRecipes": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        "agents": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        "environmentRecipes": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        "fileViewers": {
          "default": [],
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "selector": {
                "minItems": 1,
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "filenamePattern": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "filenamePattern"
                  ],
                  "additionalProperties": false
                }
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "rendering": {
                "type": "string",
                "const": "host-ui"
              },
              "mode": {
                "type": "string",
                "const": "readonly"
              }
            },
            "required": [
              "id",
              "displayName",
              "selector",
              "entry",
              "rendering",
              "mode"
            ],
            "additionalProperties": false
          }
        },
        "languages": {
          "default": [],
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "aliases": {
                "default": [],
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "extensions": {
                "default": [],
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^\\.[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
                }
              },
              "filenames": {
                "default": [],
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "configuration": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        },
        "grammars": {
          "default": [],
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "language": {
                "type": "string"
              },
              "scopeName": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)+$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "language",
              "scopeName",
              "path"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "default": [],
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "workspace:read",
              "terminal:send",
              "notifications:show",
              "storage",
              "secrets",
              "events:subscribe",
              "settings:own"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "execution": {
      "type": "string",
      "enum": [
        "data",
        "sandboxed-ui",
        "instructional",
        "trusted-worker"
      ]
    }
  },
  "required": [
    "manifestVersion",
    "id",
    "publisher",
    "name",
    "version",
    "engines",
    "pluginApi",
    "execution"
  ],
  "additionalProperties": false,
  "$comment": "Generated from Orca runtime schemas. Cross-field, path, identity, source freshness and byte limits require orca-plugin validate; JSON Schema alone is not an approval boundary."
}
