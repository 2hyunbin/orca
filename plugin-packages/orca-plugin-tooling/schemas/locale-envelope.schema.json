{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sourceHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "value": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "required": [
          "sourceHash",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "locale",
    "displayName",
    "sourceRevision",
    "entries"
  ],
  "additionalProperties": false,
  "$comment": "Generated from Orca runtime schemas. Cross-field, path, identity, source freshness and byte limits require orca-plugin validate; JSON Schema alone is not an approval boundary."
}
